<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.limber.casa</string>
  <!-- Python del venv directo (no "uv run"): así al reiniciar se cierra el proceso que tiene el puerto 8800 -->
  <key>ProgramArguments</key><array><string>$HOME/Anbernic/casa/.venv/bin/python</string><string>casa.py</string></array>
  <key>WorkingDirectory</key><string>$HOME/Anbernic/casa</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>$HOME/Anbernic/casa/casa.log</string>
  <key>StandardErrorPath</key><string>$HOME/Anbernic/casa/casa.log</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
</dict>
</plist>
